      private static function fill(dictionary:DictionaryTabel, sheet:Array) : void
      {
         var j:int = 0;
         var len:int = 0;
         var i:int = 2;
         while(i < sheet.length)
         {
            if(Boolean(sheet[i]) && Boolean(sheet[i][0]))
            {
               len += 1;
               dictionary[sheet[i][0]] = [];
               j = 1;
               while(j < sheet[i].length)
               {
                  dictionary[sheet[i][0]].push(Number(sheet[i][j]).toString() == "NaN" ? sheet[i][j] : Number(sheet[i][j]));
                  j++;
               }
            }
            i++;
         }
         dictionary.setLength(len);
      }
